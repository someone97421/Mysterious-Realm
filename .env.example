# Compose 对外暴露的端口
XINGWEI_PORT=18763

# 宿主机数据目录；容器内统一挂载到 /app/data
XINGWEI_HOST_DATA_DIR=./data

# 容器内数据目录通常保持默认值
XINGWEI_DATA_DIR=/app/data

# 仅在 HTTPS 反向代理下使用安全 Cookie
XINGWEI_COOKIE_SECURE=false

# 请求、调用与已完成进度日志：同时按天数及每类条数限制
XINGWEI_LOG_RETENTION_DAYS=90
XINGWEI_LOG_MAX_ROWS=20000

# 写入后合并触发；时间只在新写入时比较，不设定时检查
XINGWEI_LOG_CLEANUP_WRITES=100
XINGWEI_LOG_CLEANUP_COOLDOWN=300

# Docker 控制台日志轮转
XINGWEI_DOCKER_LOG_MAX_SIZE=10m
XINGWEI_DOCKER_LOG_MAX_FILES=3
