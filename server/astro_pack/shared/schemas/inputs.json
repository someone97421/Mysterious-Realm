{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.astrology-master/schemas/inputs.json",
  "title": "Astrology Master 工具输入 Schema 集合",
  "$defs": {
    "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "time": {"type": "string", "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "sign": {
      "type": "string",
      "enum": ["aries", "taurus", "gemini", "cancer", "leo", "virgo", "libra", "scorpio", "sagittarius", "capricorn", "aquarius", "pisces"]
    },
    "chart": {
      "type": "object",
      "required": ["date", "latitude", "longitude"],
      "properties": {
        "date": {"$ref": "#/$defs/date"},
        "time": {"$ref": "#/$defs/time"},
        "time_unknown": {"type": "boolean", "default": false},
        "latitude": {"$ref": "#/$defs/latitude"},
        "longitude": {"$ref": "#/$defs/longitude"},
        "timezone": {"type": "string", "description": "IANA 时区名或 auto"},
        "timezone_offset": {"type": "number", "minimum": -14, "maximum": 14},
        "house_system": {"type": "string", "enum": ["P", "K", "R", "C", "E", "W", "B", "M", "O", "A", "T", "V", "D", "F", "G", "H", "I", "i", "L", "N", "Q", "S", "U", "X", "Y"], "default": "P"},
        "zodiac_type": {"enum": ["tropical", "sidereal"], "default": "tropical"},
        "ayanamsa": {"type": ["string", "null"], "enum": ["fagan-bradley", "lahiri", "de-luce", "raman", "krishnamurti", "kp", "yukteshwar", "jn-bhasin", "true-citra", "djwhal-khul", null]},
        "name": {"type": "string"},
        "city": {"type": "string"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": ["time"],
              "not": {"required": ["time_unknown"], "properties": {"time_unknown": {"const": true}}}
            },
            {
              "required": ["time_unknown"],
              "properties": {"time_unknown": {"const": true}},
              "not": {"required": ["time"]}
            }
          ]
        }
      ]
    },
    "knownTimeChart": {
      "allOf": [
        {"$ref": "#/$defs/chart"},
        {"type": "object", "required": ["time"], "properties": {"time_unknown": {"const": false}}}
      ]
    },
    "pair": {
      "type": "object",
      "required": ["chart1", "chart2"],
      "properties": {
        "chart1": {"$ref": "#/$defs/chart"},
        "chart2": {"$ref": "#/$defs/chart"}
      },
      "additionalProperties": false
    },
    "knownTimePair": {
      "type": "object",
      "required": ["chart1", "chart2"],
      "properties": {
        "chart1": {"$ref": "#/$defs/knownTimeChart"},
        "chart2": {"$ref": "#/$defs/knownTimeChart"}
      },
      "additionalProperties": false
    },
    "moment": {
      "type": "object",
      "required": ["date"],
      "properties": {
        "date": {"$ref": "#/$defs/date"},
        "time": {"$ref": "#/$defs/time", "default": "12:00:00"},
        "timezone_offset": {"type": "number", "minimum": -14, "maximum": 14, "default": 0}
      },
      "additionalProperties": false
    },
    "renderOptions": {
      "type": "object",
      "properties": {
        "size": {"type": "integer", "minimum": 200, "maximum": 2000},
        "theme": {"enum": ["light", "dark", "console", "css"]},
        "show_aspects": {"type": "boolean"},
        "show_retrograde": {"type": "boolean"},
        "title": {"type": "string", "maxLength": 120},
        "bodies": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 14},
        "outer_label": {"type": "string", "maxLength": 40},
        "cross_aspects": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "geocode": {
      "type": "object",
      "required": ["query"],
      "properties": {"query": {"type": "string", "minLength": 2}},
      "additionalProperties": false
    },
    "natal-chart": {"$ref": "#/$defs/chart"},
    "synastry": {"$ref": "#/$defs/pair"},
    "composite-chart": {"$ref": "#/$defs/knownTimePair"},
    "transits": {
      "type": "object",
      "required": ["natal", "transit"],
      "properties": {
        "natal": {"$ref": "#/$defs/knownTimeChart"},
        "transit": {"$ref": "#/$defs/moment"}
      },
      "additionalProperties": false
    },
    "transit-calendar": {
      "type": "object",
      "required": ["natal", "start_date", "end_date"],
      "properties": {
        "natal": {"$ref": "#/$defs/knownTimeChart"},
        "start_date": {"$ref": "#/$defs/date"},
        "end_date": {"$ref": "#/$defs/date"},
        "max_orb": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "aspect_angles": {
          "type": "array",
          "items": {"type": "number", "enum": [0, 60, 90, 120, 180]},
          "maxItems": 64,
          "uniqueItems": true
        },
        "transit_planet_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}, "maxItems": 32, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "solar-return": {
      "type": "object",
      "required": ["natal", "year"],
      "properties": {
        "natal": {"$ref": "#/$defs/knownTimeChart"},
        "year": {"type": "integer", "minimum": 1, "maximum": 9999},
        "location": {
          "type": "object",
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": {"$ref": "#/$defs/latitude"},
            "longitude": {"$ref": "#/$defs/longitude"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "secondary-progressions": {
      "type": "object",
      "required": ["natal", "target"],
      "properties": {
        "natal": {"$ref": "#/$defs/knownTimeChart"},
        "target": {"$ref": "#/$defs/moment"},
        "converse": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "sky-events": {
      "type": "object",
      "properties": {
        "days": {"type": "integer", "minimum": 1, "maximum": 400, "default": 30},
        "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50},
        "min_importance": {"type": "integer", "minimum": 0, "maximum": 100, "default": 0},
        "kind": {"type": ["string", "null"]},
        "from_date": {"$ref": "#/$defs/date"}
      },
      "additionalProperties": false
    },
    "sky-event-kinds": {"type": "object", "properties": {}, "additionalProperties": false},
    "horoscope": {
      "type": "object",
      "required": ["period"],
      "properties": {
        "period": {"enum": ["daily", "weekly", "monthly"]},
        "sign": {"$ref": "#/$defs/sign"},
        "month": {"type": "string", "pattern": "^\\d{4}-\\d{2}$", "description": "仅用于月度归档"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["month"]},
          "then": {"required": ["sign"], "properties": {"period": {"const": "monthly"}}}
        }
      ]
    },
    "astro-content": {
      "type": "object",
      "required": ["topic"],
      "properties": {"topic": {"enum": ["moon", "transit", "week-ahead", "monthly-overview"]}},
      "additionalProperties": false
    },
    "electional-day": {"$ref": "#/$defs/knownTimeChart"},
    "horary-chart": {"$ref": "#/$defs/knownTimeChart"},
    "horary-diagnostics": {"$ref": "#/$defs/knownTimeChart"},
    "render-chart": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["western", "bi-wheel", "composite"]},
        "chart": {"$ref": "#/$defs/knownTimeChart"},
        "natal": {"$ref": "#/$defs/knownTimeChart"},
        "outer": {"$ref": "#/$defs/knownTimeChart"},
        "chart1": {"$ref": "#/$defs/knownTimeChart"},
        "chart2": {"$ref": "#/$defs/knownTimeChart"},
        "options": {"$ref": "#/$defs/renderOptions"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "western"}}},
          "then": {
            "required": ["chart"],
            "not": {"anyOf": [{"required": ["natal"]}, {"required": ["outer"]}, {"required": ["chart1"]}, {"required": ["chart2"]}]}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "bi-wheel"}}},
          "then": {
            "required": ["natal", "outer"],
            "not": {"anyOf": [{"required": ["chart"]}, {"required": ["chart1"]}, {"required": ["chart2"]}]}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "composite"}}},
          "then": {
            "required": ["chart1", "chart2"],
            "not": {"anyOf": [{"required": ["chart"]}, {"required": ["natal"]}, {"required": ["outer"]}]}
          }
        }
      ]
    },
    "provider-usage": {"type": "object", "properties": {}, "additionalProperties": false}
  }
}
